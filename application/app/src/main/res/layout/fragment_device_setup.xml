<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_main" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalizacja"
            android:textColor="@color/text_main"
            android:textSize="32sp"
            android:textStyle="bold"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nadaj nazwę urządzeniu i skonfiguruj połączenie z Twoim brokerem MQTT"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Nazwa Urządzenia -->
        <TextView
            android:id="@+id/lblDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAZWA URZĄDZENIA"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDeviceName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lblDeviceName">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeviceName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="np. Bramka Garaż"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MQTT Host -->
        <TextView
            android:id="@+id/lblMqttHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADRES SERWERA MQTT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilDeviceName"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMqttHost"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lblMqttHost">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMqttHost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="np. broker.hivemq.com"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MQTT Port -->
        <TextView
            android:id="@+id/lblMqttPort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PORT MQTT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilMqttHost"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMqttPort"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lblMqttPort">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMqttPort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="8883"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MQTT User -->
        <TextView
            android:id="@+id/lblMqttUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UŻYTKOWNIK MQTT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilMqttPort"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMqttUser"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lblMqttUser">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMqttUser"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MQTT Password -->
        <TextView
            android:id="@+id/lblMqttPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HASŁO MQTT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilMqttUser"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMqttPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:passwordToggleEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/lblMqttPassword">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMqttPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="40dp"
            android:text="ZAKOŃCZ I ZAPISZ"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white_bg"
            app:backgroundTint="@color/black_main"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilMqttPassword" />

        <ProgressBar
            android:id="@+id/loadingOverlay"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
